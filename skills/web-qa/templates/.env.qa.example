# Copy to .env.qa (gitignored) and fill in. Never commit .env.qa.
# Use throwaway QA accounts on a non-production environment.

# Which apps/<id>.ts to run against. Defaults to example-app.
APP=

# --- example-app ---------------------------------------------------------
# Origin under test. Must not be production.
QA_EXAMPLE_APP_URL=http://localhost:3000
QA_EXAMPLE_APP_USER_USERNAME=<set-me>
QA_EXAMPLE_APP_USER_PASSWORD=<set-me>
QA_EXAMPLE_APP_ADMIN_USERNAME=<set-me>
QA_EXAMPLE_APP_ADMIN_PASSWORD=<set-me>

# --- example-admin -------------------------------------------------------
QA_EXAMPLE_ADMIN_URL=http://localhost:3001
QA_EXAMPLE_ADMIN_STAFF_USERNAME=<set-me>
QA_EXAMPLE_ADMIN_STAFF_PASSWORD=<set-me>
QA_EXAMPLE_ADMIN_OWNER_USERNAME=<set-me>
QA_EXAMPLE_ADMIN_OWNER_PASSWORD=<set-me>

# Where traces, videos, screenshots and results.json land.
# Empty = .claude/qa/web/<runid>. The cdt-web-qa CLI sets this; leave it unset
# when running by hand.
CDT_QA_ARTIFACTS=

# Target safety. The harness THROWS at config load if an app's base URL is not loopback, because the
# suite creates and DELETES records and exercises payment flows as an authenticated user. Staging is
# legitimate — say so deliberately. Never set this against production.
# CDT_QA_ALLOW_REMOTE=1
