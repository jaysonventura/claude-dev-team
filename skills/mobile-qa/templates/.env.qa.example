# Copy to .env.qa (gitignored) and fill in. Never commit .env.qa.
# Use a throwaway QA account on a non-production environment.

# Test account for the login flow — placeholders, replace both.
QA_USERNAME=<set-me>
QA_PASSWORD=<set-me>

# Which apps/<id>.ts to run against. Defaults to example-rn.
APP=

# Device targeting. Empty = whatever is attached (`adb devices -l`).
ANDROID_DEVICE=
ANDROID_PLATFORM_VERSION=

# Appium server. Empty = local server started by the wdio appium service.
APPIUM_HOST=
APPIUM_PORT=

# Where screenshots + logcat land. Empty = .claude/mobile-qa/<runid>.
# The cdt-mobile-qa CLI sets this; leave it unset when running by hand.
CDT_MQA_ARTIFACTS=
