{
  "name": "mobile-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Appium + UiAutomator2 E2E harness — one config per app, shared flows.",
  "scripts": {
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:e2e:android": "APP=example-rn wdio run ./wdio.conf.ts",
    "typecheck": "tsc --noEmit",
    "appium:drivers": "appium driver install uiautomator2"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@wdio/appium-service": "9.30.1",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "appium": "3.6.0",
    "appium-uiautomator2-driver": "8.2.2",
    "tsx": "4.23.5",
    "typescript": "5.9.3",
    "webdriverio": "9.30.1"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
